const express = require('express');
const cors = require('cors');
const app = express();
const PORT = 5000;

app.use(cors());
app.use(express.json());

// In-Memory Database Simulation
let users = [
  { id: "f1", email: "founder@anglecoding.com", role: "founder" }
];
let products = [];
let orders = [];

// 1. REGISTRATION & SUBSCRIPTION
app.post('/api/register', (req, res) => {
  const { email, password, bankAcc, govDoc, initialRole, scanDongle } = req.body;
  
  if (!email || !password) return res.status(400).json({ error: "Missing email or password" });
  
  // Cyber Virus Detection Simulation
  let securityStatus = "Clean";
  if (scanDongle && Math.random() > 0.9) {
    securityStatus = "Threat Detected - Portable Device Quarantine Flagged";
    return res.status(403).json({ error: securityStatus });
  }

  const newUser = {
    id: 'u_' + Date.now(),
    email,
    password,
    bankAcc,
    govDoc,
    role: initialRole || 'buyer', // default role
    securityStatus
  };

  users.push(newUser);
  console.log(`[EMAIL SENT] Welcome to Angle Coding! Referral Code: REF-${newUser.id}`);
  res.status(201).json({ message: "Registration successful", user: newUser });
});

// 2. DASHBOARD: PROFILE INTERCHANGE
app.post('/api/user/switch-profile', (req, res) => {
  const { userId, targetRole } = req.body;
  const user = users.find(u => u.id === userId);
  
  if (!user) return res.status(404).json({ error: "User not found" });
  if (user.role === 'founder') return res.status(400).json({ error: "Founders cannot switch base roles" });
  
  if (targetRole === 'buyer' || targetRole === 'seller') {
    user.role = targetRole;
    console.log(`[FOUNDER NOTIFICATION] User ${user.id} switched profile to ${targetRole}`);
    return res.json({ message: `Successfully switched to ${targetRole} interface`, user });
  }
  res.status(400).json({ error: "Invalid role switch selection" });
});

// 3. SELLER: PRODUCT LISTING
app.post('/api/products', (req, res) => {
  const { sellerId, title, price, description } = req.body;
  const newProduct = {
    id: 'p_' + Date.now(),
    sellerId,
    title,
    price: parseFloat(price),
    description,
    status: 'ready'
  };
  products.push(newProduct);
  res.status(201).json({ message: "Product listed successfully", product: newProduct });
});

// 4. BUYER: NEGOTIATION & ORDER CONFORMATION
app.post('/api/orders/negotiate', (req, res) => {
  const { buyerId, productId, proposedPrice, action } = req.body;
  const product = products.find(p => p.id === productId);
  
  if (!product) return res.status(404).json({ error: "Product not found" });

  if (action === 'confirm') {
    const finalPrice = proposedPrice || product.price;
    const order = {
      orderId: 'ord_' + Date.now(),
      productId,
      buyerId,
      sellerId: product.sellerId,
      finalPrice,
      status: "Delivered"
    };
    orders.push(order);
    
    // Trigger automated email simulation to both parties
    console.log(`[EMAIL TO BUYER]: Order Confirmed for ${product.title}. Price: $${finalPrice}`);
    console.log(`[EMAIL TO SELLER]: Order Confirmed. Delivery finalized. Funds processed.`);
    
    return res.json({ message: "Congratulations! Order confirmed and delivered.", order });
  }

  res.json({ message: "Negotiation update logged counter-party notified." });
});

// 5. FOUNDER & GLOBAL FEEDS
app.get('/api/admin/audit', (req, res) => {
  res.json({ totalUsers: users.length, totalProducts: products.length, totalOrders: orders.length });
});

app.get('/api/products', (req, res) => res.json(products));

